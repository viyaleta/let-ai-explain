<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the Developer ID signed app (see packaging/macos/sign.sh).
     allow-unsigned-executable-memory: Python's ctypes/libffi and PyObjC (pywebview) build callbacks in memory.
     disable-library-validation: lets the app load the Python extension libraries PyInstaller bundles. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
