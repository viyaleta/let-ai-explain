{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/config.py": { "maxDuration": 5, "memory": 128, "includeFiles": "{lae_reader.py,api/_shared.py}" },
    "api/fetch.py": { "maxDuration": 60, "memory": 256, "includeFiles": "{lae_reader.py,api/_shared.py}" },
    "api/check-url.py": { "maxDuration": 15, "memory": 128, "includeFiles": "{lae_reader.py,api/_shared.py}" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
